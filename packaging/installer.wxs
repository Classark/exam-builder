<!--
  Classark Exam Builder - the MSI (WiX Toolset 5). Built by `package.py installer`, which
  passes Version, SourceDir (the PyInstaller folder), IconFile and MarkerFile.

  Installs for the current user only, with no admin prompt: a dual-purpose package
  (perUserOrMachine) defaulted to per-user (MSIINSTALLPERUSER=1), so Windows puts Program
  Files at %LOCALAPPDATA%\Programs and the shortcuts in the user's own Start menu and
  desktop. Settings > Apps and Control Panel list it with Uninstall (and Repair). IT can
  still install it silently (msiexec /i ... /qn), and leave the desktop shortcut out with
  DESKTOPSHORTCUT=0. Uninstalling leaves the user's exams and papers in
  %LOCALAPPDATA%\ClassarkExamBuilder (packaging/launcher.py).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Never change UpgradeCode: it is how a newer version finds and replaces this one. -->
  <Package Name="Classark Exam Builder"
           Manufacturer="Classark"
           Version="$(var.Version)"
           UpgradeCode="3D7E9B21-4C6A-4F85-A0E2-7B19C5D84F60"
           Scope="perUserOrMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Classark Exam Builder is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="DESKTOPSHORTCUT" Value="1" />
    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <!-- where it went, for Settings > Apps -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />
    <!-- nothing to change after installing: Uninstall and Repair only -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Classark Exam Builder">
        <Component Id="AppExe">
          <File Id="AppExeFile" Source="$(var.SourceDir)\ClassarkExamBuilder.exe" KeyPath="yes" />
        </Component>
        <Component Id="InstalledMarker">
          <File Source="$(var.MarkerFile)" KeyPath="yes" />
        </Component>
        <Files Include="$(var.SourceDir)\**">
          <Exclude Files="$(var.SourceDir)\ClassarkExamBuilder.exe" />
        </Files>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Classark Exam Builder">
        <Component Id="StartMenuShortcut">
          <Shortcut Name="Classark Exam Builder" Target="[#AppExeFile]" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKMU" Key="Software\Classark\Classark Exam Builder" Name="StartMenuShortcut"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Condition="DESKTOPSHORTCUT = 1">
        <Shortcut Name="Classark Exam Builder" Target="[#AppExeFile]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\Classark\Classark Exam Builder" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- "Open Classark Exam Builder" on the last screen, ticked -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Classark Exam Builder" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AppExeFile]" />
    <CustomAction Id="LaunchApp" BinaryRef="Wix4UtilCA_X86" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- Welcome, install, finish: no licence page, no folder or feature choices -->
    <UI Id="ExamBuilderUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <UIRef Id="WixUI_Common" />
  </Package>
</Wix>
